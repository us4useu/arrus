digraph metamodel {
  graph [rankdir=LR, splines=spline, nodesep=0.55, ranksep=1.0,
         bgcolor="white", fontname="Helvetica", pad=0.3];
  node  [shape=box, style="rounded,filled", fontname="Helvetica",
         margin="0.12,0.08"];
  edge  [fontname="Helvetica", fontsize=9, color="black"];
  labelloc="t"; label=<<B>L3 --- ARRUS ultrasound domain model (device-agnostic core)</B>>;

  // ---------------- Node kinds ----------------
  Device [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«abstract»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="13">Device</FONT></B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+&nbsp;<B>device_id</B> : DeviceId</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8"><I>Base for every device in ARRUS.</I></FONT></TD></TR></TABLE>>, style="rounded,filled,dashed", fillcolor="#C8E7E8"];
  Ultrasound [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«abstract»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="13">Ultrasound</FONT></B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+&nbsp;<B>sampling_frequency</B> : float <FONT POINT-SIZE="7">[Hz]</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+&nbsp;<B>current_sampling_frequency</B> : float <FONT POINT-SIZE="7">[Hz]</FONT></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8"><I>Interface for ultrasound acquisition devices.</I></FONT></TD></TR></TABLE>>, style="rounded,filled,dashed", fillcolor="#F5F5F5"];
  File [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«concrete»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="13">File</FONT></B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8"><I>File-based ultrasound "device" that replays recorded data.</I></FONT></TD></TR></TABLE>>, style="rounded,filled", fillcolor="#EDE7F6"];
  Probe [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«concrete»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="13">Probe</FONT></B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+&nbsp;<B>ordinal</B> : int</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8"><I>A probe instance connected to an ultrasound device.</I></FONT></TD></TR></TABLE>>, style="rounded,filled", fillcolor="#FBE7A0"];
  ProbeModel [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«concrete»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="13">ProbeModel</FONT></B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+&nbsp;<B>model_id</B> : ProbeModelId</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+&nbsp;<B>n_elements</B> : int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+&nbsp;<B>pitch</B> : float <FONT POINT-SIZE="7">[m]</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">-&nbsp;<B>curvature_radius</B> : float <FONT POINT-SIZE="7">[m]</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">-&nbsp;<B>tx_frequency_range</B> : Interval[float] <FONT POINT-SIZE="7">[Hz]</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">-&nbsp;<B>voltage_range</B> : Interval[int] <FONT POINT-SIZE="7">[V]</FONT></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8"><I>Static, immutable description of a probe model (P4-1, C5-2, L14-5, ...).</I></FONT></TD></TR></TABLE>>, style="rounded,filled", fillcolor="#FFF3B0"];
  ProbeModelId [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«concrete»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="13">ProbeModelId</FONT></B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+&nbsp;<B>manufacturer</B> : str</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+&nbsp;<B>name</B> : str</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8"><I>Identifier of a probe model: (manufacturer, name).</I></FONT></TD></TR></TABLE>>, style="rounded,filled", fillcolor="#F5F5F5"];
  Lens [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«concrete»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="13">Lens</FONT></B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+&nbsp;<B>thickness</B> : float <FONT POINT-SIZE="7">[m]</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+&nbsp;<B>speed_of_sound</B> : float <FONT POINT-SIZE="7">[m/s]</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">-&nbsp;<B>focus</B> : float <FONT POINT-SIZE="7">[m]</FONT></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8"><I>Optional acoustic lens on the probe surface (elevational focus).</I></FONT></TD></TR></TABLE>>, style="rounded,filled", fillcolor="#FFF0F0"];
  MatchingLayer [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«concrete»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="13">MatchingLayer</FONT></B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+&nbsp;<B>thickness</B> : float <FONT POINT-SIZE="7">[m]</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+&nbsp;<B>speed_of_sound</B> : float <FONT POINT-SIZE="7">[m/s]</FONT></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8"><I>Optional acoustic matching layer on the probe front face.</I></FONT></TD></TR></TABLE>>, style="rounded,filled", fillcolor="#FFF0F0"];
  CPU [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«concrete»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="13">CPU</FONT></B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">-&nbsp;<B>index</B> : int</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8"><I>The host CPU as a compute device.</I></FONT></TD></TR></TABLE>>, style="rounded,filled", fillcolor="#D8F5D8"];
  GPU [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«concrete»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="13">GPU</FONT></B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8"><I>A CUDA GPU as a compute device.</I></FONT></TD></TR></TABLE>>, style="rounded,filled", fillcolor="#FFE0B2"];
  GpuSettings [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«concrete»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="13">GpuSettings</FONT></B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">-&nbsp;<B>memory_limit_percentage</B> : float <FONT POINT-SIZE="7">[%]</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+&nbsp;<B>use_memory_pool</B> : bool</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8"><I>Runtime settings for a GPU device (memory pool, memory-limit fraction).</I></FONT></TD></TR></TABLE>>, style="rounded,filled", fillcolor="#F5F5F5"];
  DeviceId [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«concrete»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="13">DeviceId</FONT></B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+&nbsp;<B>device_type</B> : str</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+&nbsp;<B>ordinal</B> : int</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8"><I>Immutable compound key: (device_type, ordinal).</I></FONT></TD></TR></TABLE>>, style="rounded,filled", fillcolor="#F5F5F5"];

  // ---------------- Inheritance ----------------
  Ultrasound -> Device [arrowhead=onormal, style=dashed, penwidth=0.8, minlen=2];
  File -> Ultrasound [arrowhead=onormal, style=dashed, penwidth=0.8, minlen=2];
  Probe -> Device [arrowhead=onormal, style=dashed, penwidth=0.8, minlen=2];
  CPU -> Device [arrowhead=onormal, style=dashed, penwidth=0.8, minlen=2];
  GPU -> Device [arrowhead=onormal, style=dashed, penwidth=0.8, minlen=2];

  // ---------------- Associations (edge kinds) ----------------
  Ultrasound -> Probe [label=<<B>has_probe</B> *>, headlabel="0..1", taillabel="0..*", labeldistance=2.4, labelangle=25, arrowhead=vee, penwidth=1.0, color="black"];
  Probe -> ProbeModel [label=<<B>is_instance_of</B>>, headlabel="1", taillabel="1..*", labeldistance=2.4, labelangle=25, arrowhead=vee, penwidth=1.0, color="black"];
  ProbeModel -> ProbeModelId [label=<<B>has_model_id</B>>, headlabel="1", taillabel="1", labeldistance=2.4, labelangle=25, arrowhead=vee, penwidth=1.0, color="black"];
  ProbeModel -> Lens [label=<<B>has_lens</B>>, headlabel="0..1", taillabel="1", labeldistance=2.4, labelangle=25, arrowhead=vee, penwidth=1.0, color="black"];
  ProbeModel -> MatchingLayer [label=<<B>has_matching_layer</B>>, headlabel="0..1", taillabel="1", labeldistance=2.4, labelangle=25, arrowhead=vee, penwidth=1.0, color="black"];
  GPU -> GpuSettings [label=<<B>has_settings</B>>, headlabel="0..1", taillabel="1", labeldistance=2.4, labelangle=25, arrowhead=vee, penwidth=1.0, color="black"];
  Device -> DeviceId [label=<<B>identified_by</B>>, headlabel="0..1", taillabel="1", labeldistance=2.4, labelangle=25, arrowhead=vee, penwidth=1.0, color="black"];

  // ---------------- Legend ----------------
  subgraph cluster_legend {
    label=<<B>Legend</B>>; fontname="Helvetica"; fontsize=10;
    style="rounded,filled"; fillcolor="#FAFAFA"; color="#BDBDBD";
    labelloc="t";
    node [shape=plaintext, margin=0];
    legend [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9"><B>«abstract»</B>&nbsp;dashed box &mdash; abstract kind</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9"><B>«concrete»</B>&nbsp;solid box &mdash; concrete kind</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">triangle arrow &mdash; UML generalization (extends)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">vee arrow &mdash; association, labelled with <B>name</B> and endpoint <I>cardinality</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9"><B>*</B> after edge name &mdash; ordered or has named constraints</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">attributes shown UML-style: <B>+</B> required, <B>-</B> optional</FONT></TD></TR></TABLE>>];
  }
}